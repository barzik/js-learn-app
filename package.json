{
  "name": "js-learn-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://hebdevbook.com/learnjs",
  "scripts": {
    "dev": "npm run build-md-json && vite",
    "build": "npm run build-md-json && vite build",
    "build:wp": "npm run build-md-json && vite build --mode singlefile",
    "preview": "vite preview",
    "test": "npm run build-md-json && vitest",
    "test:ci": "npm run build-md-json && vitest run --coverage",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"e2e/**/*.js\" \"*.config.js\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" \"e2e/**/*.js\" \"*.config.js\" --fix",
    "build-md-json": "node ./build-md-json.js",
    "pull-md": "node ./pull-md.js",
    "e2e:setup": "node ./pull-md.js && node ./build-md-json.js",
    "e2e:server": "npm run e2e:setup && vite --port 3001",
    "e2e": "playwright test",
    "e2e:ci": "playwright test",
    "pre-commit": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "directory-tree": "^3.5.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": "eslint --fix"
  }
}
